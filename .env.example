# FAIRNode environment variables.
#
# Copy this file to .env and fill in the values you need:
#   cp .env.example .env
#
# Only the masternode role requires variables; node and staker work with no
# .env at all.

# --- Masternode role only --------------------------------------------------
# Masternode private key produced by:  faircoin-cli masternode genkey
MN_PRIVKEY=

# Public IP address other nodes use to reach this masternode (no port).
EXTERNAL_IP=
